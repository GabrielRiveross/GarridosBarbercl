{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "admingriveros",

  "compatibility_date": "2026-10-01",

  "main": "./worker/index.ts",

  "assets": {
    "directory": "./dist/barberia-web/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "observability": {
    "enabled": true
  }
}
